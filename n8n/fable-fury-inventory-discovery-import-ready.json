    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  table_name,\n  column_name,\n  data_type\nFROM information_schema.columns\nWHERE table_schema = 'public'\n  AND (\n    table_name ILIKE '%inventory%'\n    OR table_name ILIKE '%product%'\n    OR table_name ILIKE '%amazon%'\n    OR table_name ILIKE '%shopify%'\n    OR column_name ILIKE '%inventory%'\n    OR column_name ILIKE '%quantity%'\n    OR column_name ILIKE '%stock%'\n    OR column_name ILIKE '%available%'\n    OR column_name ILIKE '%asin%'\n  )\nORDER BY table_name, ordinal_position;",
        "options": {}
      },

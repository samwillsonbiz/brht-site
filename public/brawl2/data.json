{
  "version": "brawl2-a2",
  "title": "Fable Fury: Brawl 2",
  "heroes": [
    {
      "id": "SMA",
      "name": "Lord Smasherton",
      "slug": "hero-lord-smasherton",
      "archetype": "Get close. Hit hard.",
      "trait": "Heavy Hands",
      "traitText": "Your Attacks deal +1 damage at Range 1.",
      "ultimate": {
        "name": "SMASH HARDER!",
        "text": "Heavy Hands adds +2 damage instead of +1."
      },
      "weakness": "His biggest swings are slow and need an adjacent target. He relies on drafted Basics for defence."
    },
    {
      "id": "ALF",
      "name": "Alf Featherbottom",
      "slug": "hero-alf-featherbottom",
      "archetype": "Keep your distance. Shoot.",
      "trait": "Long Shot",
      "traitText": "Your ranged Attacks get +1 maximum Range.",
      "ultimate": {
        "name": "No Safe Distance",
        "text": "Long Shot adds +2 maximum Range instead of +1."
      },
      "weakness": "His main shots cannot hit an adjacent opponent. Movement and heavy damage usually require separate cards."
    },
    {
      "id": "SHE",
      "name": "Dr. Shealer",
      "slug": "hero-dr-shealer",
      "archetype": "Spend Health for power. Patch yourself up.",
      "trait": "Good Medicine",
      "traitText": "When one of your cards heals you, heal 1 extra Health.",
      "ultimate": {
        "name": "Miracle Worker",
        "text": "Your Hero cards’ 2-Health payments now cost 1 Health."
      },
      "weakness": "Paying Health brings her closer to losing. Healing uses a card and an Action. Her Hero pool supplies no Block."
    },
    {
      "id": "HEL",
      "name": "Helga Stonewall",
      "slug": "hero-helga",
      "archetype": "My shield is my weapon.",
      "trait": "Shield Bank",
      "traitText": "Keep your unused Block between exchanges.",
      "ultimate": {
        "name": "ABSOLUTELY NOT",
        "text": "Gain 1 Block before each of your Action cards resolves."
      },
      "weakness": "Damage can remove Block before she spends it. Paying Block makes her easier to hurt. Her strongest setup takes time."
    },
    {
      "id": "RAV",
      "name": "Raven Madison",
      "slug": "hero-raven-madison",
      "archetype": "Slip past them. Strike from the other side.",
      "trait": "Slippery",
      "traitText": "After your Move crosses the opponent, gain 1 Block.",
      "ultimate": {
        "name": "Living Shadow",
        "text": "Slippery gives 2 Block instead of 1."
      },
      "weakness": "Her ordinary hits are small. Crossings need a legal landing space. Fast attacks can catch her before she moves."
    },
    {
      "id": "FRA",
      "name": "Friar Franc",
      "slug": "hero-friar-franc",
      "archetype": "Open with a Basic. Finish with a Hero Attack.",
      "trait": "One-Two",
      "traitText": "Your opening Basic card grants Combo, even without a hit.",
      "ultimate": {
        "name": "Divine Rhythm",
        "text": "Your follow-up Attacks deal +1 damage."
      },
      "weakness": "A Combo needs another Hero card in hand. His finishers still need Range. The opponent acts before his follow-up window."
    }
  ],

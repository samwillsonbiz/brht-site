NEXT_PUBLIC_BRHT_BOOKING_URL=https://calendly.com/your-account/brht-cfo-strategy-call
FANTASY_BASKETBALL_CSV_URL=https://docs.google.com/spreadsheets/d/e/your-published-sheet/pub?output=csv

# Fantasy Basketball ESPN integration
ESPN_FANTASY_LEAGUE_ID=2090908253
ESPN_FANTASY_SEASON_ID=2027
ESPN_FANTASY_TEAM_ID=9
# Only needed for private ESPN leagues. Keep these server-side and never expose with NEXT_PUBLIC_.
ESPN_SWID=
ESPN_S2=

# Fantasy Lab Supabase persistence. Prefer the modern sb_secret_ key.
# Keep both values server-side only; never expose them with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only if needed:
# SUPABASE_SERVICE_ROLE_KEY=

# Required to call POST /api/fantasy/sync/bootstrap and future admin sync routes.
FANTASY_ADMIN_SYNC_TOKEN=

# Outside the Feed source integrations.
# Bluesky, Hacker News and GDELT currently require no credentials.
# YouTube provides a free daily API quota after enabling YouTube Data API v3 in Google Cloud.
YOUTUBE_API_KEY=

# Optional future context/synthesis layer. OpenAI web search is paid and must not be treated
# as a representative social sample; it is for discovery, source context and synthesis.
OPENAI_API_KEY=
OUTSIDE_FEED_OPENAI_MODEL=
